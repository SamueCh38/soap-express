<?xml version="1.0" encoding="UTF-8"?>
<definitions name="ConversionesService"
  targetNamespace="http://example.com/conversiones"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:tns="http://example.com/conversiones"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- 1. TIPOS: los datos que entran y salen -->
  <types>
    <xsd:schema elementFormDefault="qualified"
                targetNamespace="http://example.com/conversiones">
      <xsd:element name="CelsiusAFahrenheit">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="celsius" type="xsd:double"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="CelsiusAFahrenheitResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="fahrenheit" type="xsd:double"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>

      <xsd:element name="KilometrosAMillas">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="kilometros" type="xsd:double"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="KilometrosAMillasResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="millas" type="xsd:double"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <!-- 2. MENSAJES: uno de entrada y otro de salida por operación -->
  <message name="CelsiusAFahrenheitIn">
    <part name="parameters" element="tns:CelsiusAFahrenheit"/>
  </message>
  <message name="CelsiusAFahrenheitOut">
    <part name="parameters" element="tns:CelsiusAFahrenheitResponse"/>
  </message>
  <message name="KilometrosAMillasIn">
    <part name="parameters" element="tns:KilometrosAMillas"/>
  </message>
  <message name="KilometrosAMillasOut">
    <part name="parameters" element="tns:KilometrosAMillasResponse"/>
  </message>

  <!-- 3. PORTTYPE: las operaciones y qué mensajes usan -->
  <portType name="ConversionesPortType">
    <operation name="CelsiusAFahrenheit">
      <input message="tns:CelsiusAFahrenheitIn"/>
      <output message="tns:CelsiusAFahrenheitOut"/>
    </operation>
    <operation name="KilometrosAMillas">
      <input message="tns:KilometrosAMillasIn"/>
      <output message="tns:KilometrosAMillasOut"/>
    </operation>
  </portType>

  <!-- 4. BINDING: cómo se envía (SOAP sobre HTTP) -->
  <binding name="ConversionesBinding" type="tns:ConversionesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="CelsiusAFahrenheit">
      <soap:operation soapAction="CelsiusAFahrenheit"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="KilometrosAMillas">
      <soap:operation soapAction="KilometrosAMillas"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <!-- 5. SERVICE: dónde vive el servicio -->
  <service name="ConversionesService">
    <port name="ConversionesPort" binding="tns:ConversionesBinding">
      <soap:address location="http://localhost:3000/soap/conversiones"/>
    </port>
  </service>
</definitions>